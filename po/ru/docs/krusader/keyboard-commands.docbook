></keycombo>
              </para>
            </entry>
            <entry>
              <para
>Стандартные комбинации клавиш (&plasma;).</para>
            </entry>
          </row>
        </tbody>
      </tgroup>
    </informaltable>

    <!-- ALT+SHIFT -->
