      <listitem>
        <para>
          <link linkend="selecting-files"
>Выбор файлов</link>
        </para>
      </listitem>
      <listitem>
        <para>
          <link linkend="krviewer"
>KrViewer</link>
        </para>
      </listitem>
      <listitem>
        <para
><link linkend="diskusage"
>Использование диска</link
></para>
      </listitem>
      <listitem>
        <para
>Графический интерфейс к <link linkend="locate"
>Locate</link
></para>
      </listitem>
      <listitem>
        <para
>Модуль <menuchoice
><guimenu
